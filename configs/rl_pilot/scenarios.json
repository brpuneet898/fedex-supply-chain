{
  "scenarios": [
    {
      "id": "S1",
      "name": "Base / Moderate risk",
      "env": {
        "max_steps": 30,
        "initial_inventory": 50,
        "copula": {
          "df": 4,
          "marginals": {
            "leadtime": { "loc": 5, "scale": 2 },
            "demand":   { "loc": 100, "scale": 30 },
            "interarrival": { "loc": 2, "scale": 0.5 }
          },
          "corr": [[1.0, 0.3, 0.2],[0.3, 1.0, 0.4],[0.2, 0.4, 1.0]]
        },
        "disruption": {
          "period_mean": 10,
          "period_jitter": 2,
          "p_levels": [0.80, 0.15, 0.05]
        },
        "scri": { "threshold": 0.7, "stockout_weight": 0.5, "disruption_weight": 0.5 },
        "costs": {
          "c_h": 0.10,
          "c_b": 2.00,
          "c_o": 1.00,
          "c_disruption": 5.00,
          "lambda_scri": 10.0,
          "scri_mode": "indicator"
        }
      }
    },
    {
      "id": "S2",
      "name": "High demand volatility + more disruptions",
      "env": {
        "max_steps": 30,
        "initial_inventory": 50,
        "copula": {
          "df": 3,
          "marginals": {
            "leadtime": { "loc": 6, "scale": 2.5 },
            "demand":   { "loc": 110, "scale": 45 },
            "interarrival": { "loc": 1.8, "scale": 0.7 }
          },
          "corr": [[1.0, 0.45, 0.25],[0.45, 1.0, 0.55],[0.25, 0.55, 1.0]]
        },
        "disruption": {
          "period_mean": 9,
          "period_jitter": 3,
          "p_levels": [0.70, 0.22, 0.08]
        },
        "scri": { "threshold": 0.7, "stockout_weight": 0.55, "disruption_weight": 0.45 },
        "costs": {
          "c_h": 0.10,
          "c_b": 3.00,
          "c_o": 1.10,
          "c_disruption": 7.00,
          "lambda_scri": 14.0,
          "scri_mode": "hinge"
        }
      }
    },
    {
      "id": "S3",
      "name": "Expensive holding + faster replenishment",
      "env": {
        "max_steps": 30,
        "initial_inventory": 50,
        "copula": {
          "df": 5,
          "marginals": {
            "leadtime": { "loc": 4, "scale": 1.5 },
            "demand":   { "loc": 95, "scale": 25 },
            "interarrival": { "loc": 2.2, "scale": 0.4 }
          },
          "corr": [[1.0, 0.25, 0.15],[0.25, 1.0, 0.30],[0.15, 0.30, 1.0]]
        },
        "disruption": {
          "period_mean": 11,
          "period_jitter": 2,
          "p_levels": [0.85, 0.12, 0.03]
        },
        "scri": { "threshold": 0.7, "stockout_weight": 0.5, "disruption_weight": 0.5 },
        "costs": {
          "c_h": 0.25,
          "c_b": 2.20,
          "c_o": 1.00,
          "c_disruption": 4.00,
          "lambda_scri": 9.0,
          "scri_mode": "indicator"
        }
      }
    }
  ]
}
